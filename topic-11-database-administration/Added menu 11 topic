  Автор: Maksym Soloviov
  Таблиця: menu_items

  Рівень: MVP
    - 2 ролі з різними наборами прав (тільки читання / читання і запис)
    - 2 користувачі, кожному призначена своя роль
    - усі права видані явно через GRANT
    - REVOKE для доступу за замовчуванням
    - закоментований блок очищення в кінці

  Перед запуском мають бути виконані DDL (Topic 04) і DML (Topic 09).

  Ролі й користувачі створюються на весь сервер PostgreSQL, а не в одній базі.
  Повторний запуск дасть помилку "role ... already exists".
  Щоб запустити скрипт ще раз, спочатку окремо виконайте блок очищення
  (розкоментувавши його), потім знову закоментуйте і запустіть файл.

  Паролі нижче навчальні. У реальному проєкті паролі не зберігають у скриптах,
  які потрапляють у git.
******************************************************************************/


-- ============================================================================
-- 1. Ролі
-- ============================================================================
-- Одразу після створення ролі порожні: права з'являються лише після GRANT.
--
-- only_read      — для офіціантів і сайту: їм потрібно лише переглядати меню.
-- read_and_write — для шеф-кухаря / су-шефа: веде меню (додає нові страви
--                  та змінює існуючі).
CREATE ROLE only_read;
CREATE ROLE read_and_write;


-- ============================================================================
-- 2. Права ролей на таблицю menu_items
-- ============================================================================
-- only_read: лише SELECT — читання меню без будь-яких змін.
GRANT SELECT ON menu_items TO only_read;

-- read_and_write: SELECT, UPDATE, INSERT — читання, зміна та додавання страв.
-- DELETE свідомо НЕ видано: видалення страви зачіпає склад страв
-- (menu_item_ingredients) і замовлення, тому це залишається за адміністратором.
GRANT SELECT, UPDATE, INSERT ON menu_items TO read_and_write;


-- ============================================================================
-- 3. Користувачі
-- ============================================================================
-- Імена без лапок PostgreSQL зберігає малими літерами: dima, james.
CREATE USER Dima WITH PASSWORD 'Dima_pass';
CREATE USER James WITH PASSWORD 'James_pass';


-- ============================================================================
-- 4. Призначення ролей користувачам
-- ============================================================================
-- Dima  — офіціант: отримує всі права ролі only_read.
-- James — шеф-кухар: отримує всі права ролі read_and_write.
GRANT only_read TO Dima;
GRANT read_and_write TO James;


-- ============================================================================
-- 5. Перевірка виданих прав
-- ============================================================================
-- Виконуйте кожен запит окремо: після запуску всього файлу pgAdmin
-- показує результат лише останньої команди.

-- Очікується 3 рядки: menu_items | INSERT, SELECT, UPDATE
SELECT grantee, table_name, privilege_type
FROM information_schema.table_privileges
WHERE grantee = 'read_and_write';

-- Очікується 1 рядок: menu_items | SELECT
SELECT grantee, table_name, privilege_type
FROM information_schema.table_privileges
WHERE grantee = 'only_read';


-- ============================================================================
-- 6. Обмеження доступу для всіх інших
-- ============================================================================
-- Явно забираємо всі права на menu_items у PUBLIC (усіх користувачів),
-- щоб доступ мали лише ролі, яким його видано вище.
-- Права ролей only_read і read_and_write це не зачіпає: вони видані окремо.
-- Принцип мінімальних привілеїв: не покладаємося на налаштування за замовчуванням.
REVOKE ALL ON menu_items FROM PUBLIC;


-- ============================================================================
-- 7. Демонстрація (необов'язково, закоментовано)
-- ============================================================================
-- SET ROLE дозволяє виконувати запити від імені користувача.
-- Розкоментуйте та виконайте окремо.
--
-- Dima: читати може, змінювати — ні.
-- SET ROLE dima;
-- SELECT name, price FROM menu_items LIMIT 3;          -- працює
-- UPDATE menu_items SET price = 1 WHERE menu_item_id = 1;
--                                                      -- ERROR: permission denied
-- RESET ROLE;
--
-- James: змінювати може, видаляти — ні. Перевірка в транзакції,
-- щоб не змінити дані: ROLLBACK скасовує і UPDATE, і SET ROLE.
-- BEGIN;
-- SET ROLE james;
-- UPDATE menu_items SET price = price + 1 WHERE menu_item_id = 1;  -- UPDATE 1
-- DELETE FROM menu_items WHERE menu_item_id = 1;       -- ERROR: permission denied
-- ROLLBACK;


-- ============================================================================
-- 8. Очищення після тестування (закоментовано)
-- ============================================================================
-- Порядок важливий:
--   1) видалити користувачів;
--   2) забрати права в ролей (роль не можна видалити, поки в неї є права);
--   3) видалити ролі.
--
-- DROP USER Dima;
-- DROP USER James;
--
-- REVOKE ALL ON menu_items FROM only_read;
-- REVOKE ALL ON menu_items FROM read_and_write;
--
-- DROP ROLE only_read;
-- DROP ROLE read_and_write;
