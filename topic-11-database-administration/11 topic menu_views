  SQL VIEWS (TOPIC 10) — секція «Меню та страви»
  Автор: Maksym Soloviov
  Базові таблиці: menu_categories, menu_items

  Рівень: MVP (завдання 01–04) + завдання 08 (WITH CHECK OPTION).

  Перед запуском мають бути виконані DDL (Topic 04) і DML (Topic 09):
  view читають дані з уже створених і наповнених таблиць.

  Скрипт можна запускати повторно: усі view створюються через
  CREATE OR REPLACE VIEW.

  Назви типів view узято за лекцією Topic 10:
    horizontal — відбір рядків (є WHERE, усі стовпці);
    vertical   — вибір стовпців (частина стовпців, без WHERE).
  У таблиці завдань описи пунктів 01 і 02 подано навпаки.
  У файлі є обидва типи view.
******************************************************************************/


-- ============================================================================
-- 01. HORIZONTAL VIEW — відбір рядків
-- ============================================================================
-- Що показує: страви, які готуються не довше 20 хвилин (усі стовпці).
-- Для кого:   офіціанти та сайт — добірка «швидких» страв для гостей,
--             які поспішають.
-- Зв'язок зі схемою: одна базова таблиця menu_items; рядки відбирає
--             умова за стовпцем preparation_time_min.
CREATE OR REPLACE VIEW menu_horizontal_view AS
SELECT *
FROM menu_items
WHERE preparation_time_min <= 20;

-- Демо: на даних із DML очікується 13 рядків із 18.
SELECT * FROM menu_horizontal_view;


-- ============================================================================
-- 02. VERTICAL VIEW — вибір стовпців
-- ============================================================================
-- Що показує: довідник категорій меню — номер і назва, без опису.
-- Для кого:   сайт і каса — список розділів меню (фільтр, випадаючий список).
-- Зв'язок зі схемою: одна базова таблиця menu_categories; стовпець
--             description у view не потрапляє.
CREATE OR REPLACE VIEW menu_vertical_view AS
SELECT category_id, name
FROM menu_categories;

-- Демо: очікується 10 рядків (усі категорії), 2 стовпці з 3.
SELECT * FROM menu_vertical_view;


-- ============================================================================
-- 03. MIXED VIEW — вибір стовпців і відбір рядків разом
-- ============================================================================
-- Що показує: доступні для замовлення страви, дорожчі за 300 грн —
--             назва, ціна та ознака доступності.
-- Для кого:   менеджер закладу — перелік найдорожчих позицій меню.
-- Зв'язок зі схемою: одна базова таблиця menu_items; поєднує вибір
--             стовпців (3 із 6) і відбір рядків (WHERE).
CREATE OR REPLACE VIEW menu_mixed_view AS
SELECT name, price, is_available
FROM menu_items
WHERE price > 300 AND is_available = TRUE;

-- Демо: на даних із DML очікується 6 рядків.
SELECT * FROM menu_mixed_view;


-- ============================================================================
-- 04. JOIN-BASED VIEW — дані з двох таблиць
-- ============================================================================
-- Що показує: назву кожної страви разом із назвою її категорії.
-- Для кого:   сайт і друковане меню, де страви подано за розділами.
-- Зв'язок зі схемою: menu_items з'єднано з menu_categories за зовнішнім
--             ключем menu_items.category_id -> menu_categories.category_id.
--             В обох таблицях є стовпець name, тому у view вони мають
--             різні назви: dish_name і category_name.
CREATE OR REPLACE VIEW join_tables_view AS
SELECT menu_items.name AS dish_name, menu_categories.name AS category_name
FROM menu_items
JOIN menu_categories
  ON menu_items.category_id = menu_categories.category_id;

-- Демо: очікується 18 рядків — кожна страва рівно один раз.
SELECT * FROM join_tables_view;


-- ============================================================================
-- 08. UPDATABLE VIEW WITH CHECK OPTION
-- ============================================================================
-- Що показує: десерти (категорія 5), дешевші за 265 грн, усі стовпці.
-- Для кого:   кондитер, який веде лише ці десерти. View не дає випадково
--             перенести страву в іншу категорію або підняти ціну
--             до 265 грн і вище.
-- Зв'язок зі схемою: одна базова таблиця menu_items, без JOIN, GROUP BY
--             та агрегатів, тому view оновлюваний: зміни через нього
--             потрапляють у menu_items.
-- WITH CHECK OPTION: через цей view не можна додати або змінити рядок так,
--             щоб він перестав відповідати умові WHERE.
CREATE OR REPLACE VIEW deserts_category_view AS
SELECT *
FROM menu_items
WHERE category_id = 5 AND price < 265
WITH CHECK OPTION;

-- Демо: на даних із DML очікується 2 рядки (ціни 220.00 і 264.00).
SELECT * FROM deserts_category_view;

-- Перевірка WITH CHECK OPTION.
-- Запит нижче навмисно порушує умову view і має завершитися помилкою,
-- тому він закоментований — інакше скрипт зупинився б.
-- Щоб перевірити, розкоментуйте та виконайте запит окремо.
-- Після + 50 ціни стають 270.00 і 314.00, тобто вже не менші за 265.
-- Очікувана помилка:
--   ERROR: new row violates check option for view "deserts_category_view"
--
-- UPDATE deserts_category_view
-- SET price = price + 50;
